@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET Eigen3::Eigen)
  find_dependency(Eigen3 3.3 CONFIG QUIET)
endif()

if(NOT TARGET Eigen3::Eigen)
  if(DEFINED EIGEN3_INCLUDE_DIR AND EXISTS "${EIGEN3_INCLUDE_DIR}/Eigen/Dense")
    add_library(Eigen3::Eigen INTERFACE IMPORTED)
    set_target_properties(Eigen3::Eigen PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${EIGEN3_INCLUDE_DIR}"
    )
  elseif(DEFINED ENV{EIGEN3_INCLUDE_DIR} AND EXISTS "$ENV{EIGEN3_INCLUDE_DIR}/Eigen/Dense")
    add_library(Eigen3::Eigen INTERFACE IMPORTED)
    set_target_properties(Eigen3::Eigen PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "$ENV{EIGEN3_INCLUDE_DIR}"
    )
  else()
    message(FATAL_ERROR
      "ModernRoboticsCpp requires Eigen3. Install Eigen3 or set EIGEN3_INCLUDE_DIR "
      "to the directory containing Eigen/Dense before calling find_package(ModernRoboticsCpp).")
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ModernRoboticsCppTargets.cmake")
